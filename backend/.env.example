NODE_ENV=production
PORT=4000

# ── DATABASE ──────────────────────────────────────────────────────────────────
# SQLite on Render: use a persistent disk mounted at /data
# Set DATABASE_URL=file:/data/prod.db in Render environment variables
# Local dev: DATABASE_URL=file:./prisma/dev.db
DATABASE_URL=file:/data/prod.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your Render Static Site URL (e.g. https://nagrik-setu.onrender.com)
FRONTEND_ORIGIN=https://your-frontend.onrender.com

# ── JWT SECRETS (generate strong random strings, min 32 chars) ───────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP / BCRYPT ──────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
BCRYPT_ROUNDS=10
RESEND_COOLDOWN_SECONDS=60

# ── SMTP (Gmail App Password recommended) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=you@gmail.com
